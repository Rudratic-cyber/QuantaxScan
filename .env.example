API_BASE_URL=https://REPLACE_WITH_YOUR_REPLIT_APP_URL.replit.app

# Comma-separated API keys accepted by the API server. REQUIRED — the server
# refuses to start without it, so that a deployment can never serve an
# unauthenticated API. Generate with: openssl rand -base64 32
# `.env` is git-ignored (S5/G-13 closed); still supply this through the
# deployment's secret store rather than a file on the box.
QUANTAXSCAN_API_KEYS=REPLACE_WITH_A_RANDOM_KEY

# Which organisation the shared-API-key principal acts as. The key is a
# break-glass / machine credential, and binding it to one organisation is what
# stops it reading everything. Defaults to 1 — the organisation every existing
# row already belongs to. See docs/Claude/13-auth-and-tenancy.md §6.1.
QUANTAXSCAN_API_KEY_ORG_ID=1

# Comma-separated origins allowed to call the API cross-origin from a browser.
# Same-origin deployments need no entry. Example:
# CORS_ALLOWED_ORIGINS=https://quantaxscan.swotpam.com
CORS_ALLOWED_ORIGINS=

# ── Rate limiting (S6) ──────────────────────────────────────────────────────
# Number of proxies in front of this server, e.g. 1 for a single load balancer.
# REQUIRED behind a reverse proxy: unset, `req.ip` is the proxy's address for
# every request and every IP-keyed rate-limit bucket collapses into one, which
# rate-limits the whole world together. A bare `true` is rejected at startup —
# it trusts every hop, so a client can forge X-Forwarded-For and mint a fresh
# bucket per request.
TRUST_PROXY=

# Per-window request budgets. All optional; the defaults are in
# artifacts/api-server/src/lib/rate-limit.ts and reflect what each route costs.
# The store is in-process, so these are per replica.
# RATE_LIMIT_EDGE_MAX=300       # per IP, per 5 min, before authentication
# RATE_LIMIT_DEFAULT_MAX=120    # per principal, per 5 min, unnamed routes
# RATE_LIMIT_GITHUB_MAX=12      # per principal, per hour — spends GitHub quota
# RATE_LIMIT_SCAN_MAX=30        # per principal, per 5 min — CPU-bound scans
# RATE_LIMIT_CHAT_MAX=30        # per principal, per hour — billed LLM calls

# ── Database ────────────────────────────────────────────────────────────────
# Runtime connection. This MUST authenticate as `quantaxscan_app`: a role with
# no table ownership and no BYPASSRLS, so the row-level-security policies are
# not optional for it. Connecting as the owner or as a superuser turns tenant
# isolation into theatre. See docs/Claude/13-auth-and-tenancy.md §5.2.
DATABASE_URL=postgres://quantaxscan_app:REPLACE_ME@localhost:5432/quantaxscan

# Migration/DDL connection — used by `drizzle-kit push`, `apply-tenancy` and
# `apply-rls`. Never used to serve a request.
DATABASE_URL_MIGRATOR=postgres://quantaxscan_migrator:REPLACE_ME@localhost:5432/quantaxscan

# Passwords assigned to the two roles by `apply-rls`. Optional: if unset, the
# roles are created without one (and so cannot log in) and you assign one by
# hand.
QUANTAXSCAN_APP_DB_PASSWORD=
QUANTAXSCAN_MIGRATOR_DB_PASSWORD=

# The email address seeded as the owner of organisation 1 by `apply-tenancy`.
# Required by that script; it refuses to run without it.
CAPTAIN_EMAIL=
