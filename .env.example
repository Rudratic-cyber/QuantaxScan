API_BASE_URL=https://REPLACE_WITH_YOUR_REPLIT_APP_URL.replit.app

# Comma-separated API keys accepted by the API server. REQUIRED — the server
# refuses to start without it, so that a deployment can never serve an
# unauthenticated API. Generate with: openssl rand -base64 32
# Keep this out of .env (which is tracked in git — see G-13) and out of the
# frontend bundle; supply it through the deployment's secret store.
QUANTAXSCAN_API_KEYS=REPLACE_WITH_A_RANDOM_KEY

# Comma-separated origins allowed to call the API cross-origin from a browser.
# Same-origin deployments need no entry. Example:
# CORS_ALLOWED_ORIGINS=https://quantaxscan.swotpam.com
CORS_ALLOWED_ORIGINS=
