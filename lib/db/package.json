{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./classification": "./src/classification.ts",
    "./roles": "./src/schema/auth-enums.ts",
    "./credentials": "./src/credentials.ts",
    "./org-scope": "./src/org-scope.ts",
    "./tenant-isolation": "./src/tenant-isolation.ts",
    "./test-support": "./src/test-support/test-db.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "apply-tenancy": "node --experimental-strip-types ./scripts/apply-tenancy.ts",
    "apply-rls": "node --experimental-strip-types ./scripts/apply-rls.ts",
    "create-organization": "node --experimental-strip-types ./scripts/create-organization.ts",
    "test": "vitest run",
    "typecheck": "tsc --build --force"
  },
  "dependencies": {
    "@workspace/collectors": "workspace:*",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "vitest": "^4.1.10"
  }
}
